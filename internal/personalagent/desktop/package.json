{
  "name": "cockpit-personal-agent",
  "productName": "Cockpit Personal Agent",
  "version": "0.4.36",
  "description": "Desktop app for the local Cockpit Personal Agent",
  "author": "AICockpit",
  "homepage": "https://github.com/lleitep3/aicockpit",
  "desktopName": "cockpit-personal-agent",
  "license": "Apache-2.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "test": "node --test runtime.test.cjs ../web/markdown.test.cjs ../web/interaction.test.cjs",
    "build:backend": "node scripts/build-backend.cjs",
    "start": "electron --no-sandbox .",
    "prestart": "npm run build:backend",
    "pack:linux": "npm run build:backend && electron-builder --linux --dir",
    "dist:linux": "npm run build:backend && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.aicockpit.personalagent",
    "productName": "Cockpit Personal Agent",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "runtime.cjs",
      "package.json",
      "assets/cockpit-512.png"
    ],
    "extraResources": [
      {
        "from": "resources/bin/cockpit",
        "to": "bin/cockpit"
      }
    ],
    "linux": {
      "category": "Development",
      "icon": "assets/cockpit-512.png",
      "maintainer": "AICockpit Project",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "cockpit-personal-agent-${version}-${arch}.${ext}"
    }
  }
}
